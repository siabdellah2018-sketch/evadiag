# انسخ هذا الملف إلى .env.local وضع القيم الحقيقية من مشروع Supabase الخاص بك
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# كلمة السر التي ستستعملها أنت (الأستاذ) لدخول لوحة التحكم — اختر كلمة سر قوية
TEACHER_ACCESS_CODE=change-this-password
